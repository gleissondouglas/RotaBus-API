# Servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/rotabus_api?schema=public"
PERSISTENCE_DRIVER="postgres" # Use "memory" apenas para testes locais sem banco

# Segurança
JWT_SECRET="insira-um-segredo-longo-e-seguro-aqui"
JWT_REFRESH_SECRET="insira-outro-segredo-longo-e-seguro-aqui"
REFRESH_TOKEN_EXPIRY=30d

# Google Routes API (usada no backend para calcular rotas)
# GOOGLE_MAPS_BACKEND_API_KEY tem prioridade — crie uma chave exclusiva do backend
# com restrição de IP no Google Cloud Console para maior segurança
GOOGLE_MAPS_API_KEY="sua-chave-api-do-google-cloud"
# GOOGLE_MAPS_BACKEND_API_KEY="chave-exclusiva-backend-com-restricao-de-ip"

# Gemini AI (opcional - usado no VoiceIntentParser quando heurísticas locais falham)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua-chave-api-do-google-gemini"

# CORS (origens permitidas pelo servidor, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
